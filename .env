# Self-Hosted AI Software Factory Configuration

# --- Models ---
OLLAMA_URL=http://ollama:11434
AGENT_MODEL=llama3.1:latest
TEAMLEAD_MODEL=llama3.1:latest

# --- Orchestrator Settings ---
ORCHESTRATOR_PORT=8000
LLM_TIMEOUT_SEC=600
LLM_MAX_RETRIES=3
OLLAMA_NUM_PARALLEL=1

# --- Storage & Logs ---
LOG_RETENTION_DAYS=30
ARCHIVE_RETENTION_DAYS=90
TRACE_DB_PATH=/app/data/traceability.db

# --- Security ---
AUTH_ENABLED=true
ADMIN_PASSWORD=change-me-immediately # PO should update this
